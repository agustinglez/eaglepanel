# Local development. In production these values are set by the systemd units.

# --- Agent ---
# Sandbox: runs no commands and writes only inside EAGLEPANEL_SANDBOX_DIR.
EAGLEPANEL_SANDBOX=1
EAGLEPANEL_SANDBOX_DIR=.sandbox
AGENT_DEV_PORT=8091

# --- API ---
EAGLEPANEL_DB=.data/eaglepanel.db
API_PORT=8090
AGENT_URL=http://127.0.0.1:8091
# Production only, instead of AGENT_URL:
# AGENT_SOCKET=/run/eaglepanel/agent.sock
