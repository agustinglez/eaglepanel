{
  "name": "eaglepanel",
  "version": "0.2.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:agent": "bun run --filter @eaglepanel/agent dev",
    "dev:api": "bun run --filter @eaglepanel/api dev",
    "dev:web": "bun run --filter @eaglepanel/web dev",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter @eaglepanel/web build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "admin:set": "bun run --filter @eaglepanel/api admin:set"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
